{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "One append-only, hash-linked run state transition.",
  "properties": {
    "causal_parent_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Causal Parent Ids",
      "type": "array"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "event_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Event Version",
      "type": "string"
    },
    "monotonic_ns": {
      "minimum": 0,
      "title": "Monotonic Ns",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Event Hash"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "event_type",
    "monotonic_ns",
    "occurred_at",
    "payload_sha256"
  ],
  "title": "EventRecord",
  "type": "object"
}
