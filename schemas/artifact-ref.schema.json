{
  "additionalProperties": false,
  "description": "Reference to immutable bytes in a content-addressed artifact store.",
  "properties": {
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "storage_ref": {
      "minLength": 1,
      "title": "Storage Ref",
      "type": "string"
    }
  },
  "required": [
    "media_type",
    "size_bytes",
    "sha256",
    "storage_ref"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
