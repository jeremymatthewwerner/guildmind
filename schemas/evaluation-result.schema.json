{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes in a content-addressed artifact store.",
      "properties": {
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_ref": {
          "minLength": 1,
          "title": "Storage Ref",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "size_bytes",
        "sha256",
        "storage_ref"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "JsonValue": {},
    "RunStatus": {
      "description": "Lifecycle state for an attempted run.",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "budget_exhausted",
        "infrastructure_error"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Content-verified result from a versioned, isolated evaluator.",
  "properties": {
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluation_id": {
      "minLength": 1,
      "title": "Evaluation Id",
      "type": "string"
    },
    "evaluator_version": {
      "minLength": 1,
      "title": "Evaluator Version",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "error",
        "not_run"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "patch_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Patch Hash"
    },
    "result": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Result",
      "type": "object"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "$ref": "#/$defs/RunStatus"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "signature": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    },
    "task_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Hash",
      "type": "string"
    }
  },
  "required": [
    "evaluation_id",
    "run_id",
    "run_status",
    "evaluator_version",
    "task_hash",
    "outcome",
    "result_sha256",
    "evaluated_at"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
