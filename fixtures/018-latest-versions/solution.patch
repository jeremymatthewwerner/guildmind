 from typing import Any
 
 Record = dict[str, Any]
+VersionKey = tuple[int, int, int, int, tuple[tuple[int, int | str], ...]]
+
+
+def _version_key(version: str) -> VersionKey:
+    """Return a directly comparable SemVer precedence key."""
+
+    precedence = version.split("+", 1)[0]
+    if "-" in precedence:
+        core, prerelease = precedence.split("-", 1)
+    else:
+        core, prerelease = precedence, None
+    major, minor, patch = (int(component) for component in core.split("."))
+    if prerelease is None:
+        return major, minor, patch, 1, ()
+    identifiers = tuple(
+        (0, int(identifier)) if identifier.isdigit() else (1, identifier)
+        for identifier in prerelease.split(".")
+    )
+    return major, minor, patch, 0, identifiers
 
 
